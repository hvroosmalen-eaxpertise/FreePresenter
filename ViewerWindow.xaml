<Window x:Class="FreePresenter.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viewer"
        Background="Black"
        AllowsTransparency="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">
    <Grid>
        <Image x:Name="imgDisplay" Visibility="Collapsed" Stretch="Uniform" />
        <MediaElement x:Name="mediaDisplay" Visibility="Collapsed" Stretch="Uniform"
                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                      MediaEnded="Media_Ended" />
        <Button x:Name="btnClose" Content="✕" Width="36" Height="36"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,8,8,0" Opacity="0.7"
                Background="#80000000" Foreground="White"
                BorderThickness="0" FontSize="16" Cursor="Hand"
                Click="BtnClose_Click" />
    </Grid>
</Window>
