<Window x:Class="FreePresenter.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Viewer"
        Background="Black"
        AllowsTransparency="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        MouseMove="Window_MouseMove">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Image x:Name="imgDisplay" Visibility="Collapsed" Stretch="Uniform" />
            <vlc:VideoView x:Name="videoView" Visibility="Collapsed" />
        </Grid>

        <Border x:Name="transportBar" Grid.Row="1" Visibility="Collapsed" Height="44"
                Background="#B0000000" Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="btnPlayPause" Content="▶" Width="36" Height="36"
                        Grid.Column="0" Background="Transparent" Foreground="White"
                        BorderThickness="0" FontSize="16" Cursor="Hand"
                        Click="BtnPlayPause_Click" />

                <TextBlock x:Name="txtTime" Text="00:00 / 00:00"
                           Grid.Column="1" VerticalAlignment="Center"
                           Foreground="White" FontSize="12"
                           Margin="8,0,8,0" />

                <Slider x:Name="seekSlider" Grid.Column="2"
                        VerticalAlignment="Center" Value="0"
                        Minimum="0" Maximum="1000"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        PreviewMouseDown="SeekSlider_PreviewMouseDown"
                        PreviewMouseUp="SeekSlider_PreviewMouseUp"
                        ValueChanged="SeekSlider_ValueChanged" />

                <TextBlock x:Name="txtStatus" Grid.Column="3"
                           VerticalAlignment="Center" Foreground="#FFD700" FontSize="12"
                           Margin="4,0" Text="" />

                <TextBlock Text="🔊" Grid.Column="4" VerticalAlignment="Center"
                           Foreground="White" FontSize="14" Margin="8,0,4,0" />

                <Slider x:Name="volumeSlider" Grid.Column="5" Width="100"
                        VerticalAlignment="Center" Value="100"
                        Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                        ValueChanged="VolumeSlider_ValueChanged" />
            </Grid>
        </Border>

        <Button x:Name="btnClose" Content="&#x2715;" Width="36" Height="36"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,8,8,0" Opacity="0.7"
                Background="#80000000" Foreground="White"
                BorderThickness="0" FontSize="16" Cursor="Hand"
                Click="BtnClose_Click" />
    </Grid>
</Window>