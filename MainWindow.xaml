<Window x:Class="FreePresenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreePresenter" Width="500" Height="400"
        AllowDrop="True" WindowStartupLocation="CenterScreen"
        DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" Drop="Window_Drop"
        Background="#2d2d2d" WindowStyle="None" ResizeMode="CanResize">

    <DockPanel LastChildFill="True">
        <Border Background="Black" Height="36" DockPanel.Dock="Top">
            <Grid>
                <TextBlock Text="FreePresenter" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold"
                           MouseDown="TopBar_MouseDown" />
                <Button x:Name="btnCloseApp" Content="&#x2715;" Width="36" Height="36"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" FontSize="16" Cursor="Hand"
                        Click="BtnCloseApp_Click" />
            </Grid>
        </Border>
        <Grid Margin="20">
        <Border x:Name="dropBorder" BorderBrush="#555" BorderThickness="3"
                CornerRadius="12" Background="#1e1e1e"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Viewbox Stretch="Uniform" MaxWidth="300">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4C1;" FontSize="64"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="txtInstruction" Text="Drop an image or video file here"
                               FontSize="18" Foreground="#aaa" HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                    <TextBlock x:Name="txtFileInfo" Text="" FontSize="13" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Viewbox>
        </Border>
    </Grid>
    </DockPanel>
</Window>
